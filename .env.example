# ── Frontend (Vite) ────────────────────────────────────────────────
# Base URL of the Climora backend API. No trailing slash.
VITE_API_BASE_URL=http://localhost:5000/api

# Per-request timeout for backend calls, in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Password protecting the Command Center workspace. Interpreted at build time
# (Vite inlines VITE_* vars); defaults to the demo password if unset.
VITE_COMMAND_CENTER_PASSWORD=climora@2026

# ── Electron (dev only) ────────────────────────────────────────────
# Renderer URL the desktop shell loads in development.
# Production builds load the bundled renderer from dist-renderer/ instead.
ELECTRON_RENDERER_URL=http://localhost:5173

# Copy this file to ".env" and adjust values. Never commit .env.

# ── Auth & Security ───────────────────────────────────────────────
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email (for verification/password reset) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@climora.app
