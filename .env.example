# ── Frontend (Vite) ────────────────────────────────────────────────
# Base URL of the Climora backend API. No trailing slash.
VITE_API_BASE_URL=http://localhost:5000/api

# Per-request timeout for backend calls, in milliseconds.
VITE_API_TIMEOUT_MS=15000

# ── Electron (dev only) ────────────────────────────────────────────
# Renderer URL the desktop shell loads in development.
# Production builds load the bundled renderer from dist-renderer/ instead.
ELECTRON_RENDERER_URL=http://localhost:5173

# Copy this file to ".env" and adjust values. Never commit .env.
