# ---------------------------------------------------------------------------
# Climora backend configuration — copy to .env and adjust.
# Placeholders only. Never commit real secrets.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=5000

# Comma separated list of allowed browser origins for CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Node environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Path to the SQLite file used for local persistence
DATABASE_PATH=./data/climora.db

# Set to "true" to insert clearly-labelled demo schemes / demo businesses on
# first initialisation only. Existing rows are never deleted.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Climate data provider (Open-Meteo — free tier, no API key required)
# Docs: https://open-meteo.com/en/docs
# ---------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_FLOOD_BASE_URL=https://flood-api.open-meteo.com
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com

# Request timeout in milliseconds for outbound climate API calls
CLIMATE_TIMEOUT_MS=8000

# How long cached climate payloads stay valid, in minutes
CLIMATE_CACHE_TTL_MINUTES=360

# "true" keeps every dimension available by substituting clearly-labelled demo
# values when the provider is unreachable. "false" marks dimensions missing.
CLIMATE_ALLOW_DEMO_FALLBACK=true
