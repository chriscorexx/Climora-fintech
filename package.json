{
  "name": "climora",
  "version": "1.0.1",
  "private": true,
  "description": "Climora — Climate-Adjusted Risk Scoring & FinTech Platform for MSMEs",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Climora Team",
  "desktopName": "climora",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,WEB,DESKTOP\" -c \"cyan,magenta,green\" \"npm run dev:server\" \"npm run dev:client\" \"node scripts/dev-electron.mjs\"",
    "dev:web": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/server.ts",
    "desktop": "node scripts/dev-electron.mjs",
    "server": "tsx server/src/server.ts",
    "build": "tsc && vite build",
    "build:website": "npm run build && node -e \"const fs=require('fs');const keep=new Set(['README.md','_redirects']);fs.mkdirSync('website',{recursive:true});for (const e of fs.readdirSync('website')) if(!keep.has(e)) fs.rmSync('website/'+e,{recursive:true,force:true});for (const e of fs.readdirSync('dist')) fs.cpSync('dist/'+e,'website/'+e,{recursive:true});console.log('website/ synced from dist/ (README.md and _redirects preserved)')\"",
    "package": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder --win --linux --mac",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.8.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.climora.app",
    "productName": "Climora",
    "copyright": "Copyright © 2026 Climora",
    "asar": true,
    "compression": "normal",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**/*",
      "public/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "defaultArch": "x64",
      "icon": "build/icons/linux",
      "category": "Office",
      "syncDesktopName": true,
      "maintainer": "Climora Team <noreply@climora.app>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.productivity"
    }
  }
}
