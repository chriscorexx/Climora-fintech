{
  "name": "climora",
  "version": "0.1.0",
  "description": "Climate-adjusted risk scoring and loan readiness for MSMEs",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:web": "vite",
    "dev:electron": "ELECTRON_RENDERER_URL=http://localhost:5173 node scripts/dev-electron.mjs",
    "build": "vite build && electron-builder build",
    "lint": "eslint src/ electron/ scripts/ --fix",
    "test": "vitest run"
  },
  "allowScripts": {
    "electron": "postinstall",
    "esbuild": "postinstall",
    "electron@33.2.0": true,
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.climora.app",
    "productName": "Climora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chriscorexx/Climora-fintech"
  },
  "keywords": [
    "climate-risk",
    "msme",
    "lending",
    "electron",
    "react",
    "node.js",
    "sqlite"
  ],
  "author": "Climora Team",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.12.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
