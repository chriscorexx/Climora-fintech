# ---------------------------------------------------------------------------
# Climora frontend (Electron + React renderer) — copy to .env as needed.
# Placeholders only. Never commit real secrets.
# ---------------------------------------------------------------------------

# Base URL the renderer uses to reach the Express backend.
# Leave commented to use the automatic default:
#   - http://127.0.0.1:5000 in dev and in the Electron renderer
#   - proxied through the Vite dev server when set to "/api"
# VITE_API_BASE_URL=http://127.0.0.1:5000

# Backend port the Vite dev server proxies /api to.
# VITE_API_TARGET=http://127.0.0.1:5000
